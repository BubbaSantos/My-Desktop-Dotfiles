#!/bin/bash
# cara-log - generate the TOTP code directly and type it into the focused window.
SECRET_FILE="$HOME/.config/cara-totp-secret"

if [ ! -r "$SECRET_FILE" ]; then
    notify-send "cara-log" "Missing $SECRET_FILE" -t 3000
    exit 1
fi

code=$(oathtool --totp -b "$(tr -d ' \n' < "$SECRET_FILE")") || exit 1

# Wait for SUPER (from the keybind) to be released so it doesn't combine with the digits
sleep 0.25
wtype "$code"
sleep 0.05
wtype -k Return
