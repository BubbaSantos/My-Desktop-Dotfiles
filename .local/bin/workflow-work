#!/bin/bash
SLEEP=0.3
LAUNCH_SLEEP=0.8
GROUP_SLEEP=1.2

# --- Workspace 1: Vivaldi, ChatGPT, To Do ---
hyprctl dispatch workspace 1
sleep $SLEEP
vivaldi --ozone-platform=wayland --enable-features=TouchpadOverscrollHistoryNavigation,UseOzonePlatform,WaylandWindowDecorations --force-device-scale-factor=1 https://midaspro.mab.org.uk/Midas.Homepage/ &
sleep $LAUNCH_SLEEP
chromium --app="https://chatgpt.com" &
sleep $GROUP_SLEEP
hyprctl dispatch togglegroup
sleep $SLEEP
chromium --app="https://claude.ai/new" &
sleep $LAUNCH_SLEEP
hyprctl dispatch lockactivegroup lock
sleep $SLEEP

# --- Workspace 2: Outlook, ChatGPT, To Do ---
hyprctl dispatch workspace 2
sleep $SLEEP
~/.local/bin/toggle-outlook.sh &
sleep $LAUNCH_SLEEP
chromium --app="https://chatgpt.com" &
sleep $GROUP_SLEEP
hyprctl dispatch togglegroup
sleep $SLEEP
chromium --app="https://claude.ai/new" &
sleep $LAUNCH_SLEEP
hyprctl dispatch lockactivegroup lock
sleep $SLEEP

# --- Workspace 3: Teams ---
hyprctl dispatch workspace 3
sleep $SLEEP
/opt/teams-for-linux/teams-for-linux &
sleep $LAUNCH_SLEEP

# Focus Workspace 1 while Teams loads in background
hyprctl dispatch workspace 1
sleep $LAUNCH_SLEEP

# Move Teams to workspace 3
ADDRESS=$(hyprctl clients -j | jq -r '.[] | select(.class == "teams-for-linux") | .address' | head -1)
if [ -n "$ADDRESS" ]; then
    hyprctl dispatch movetoworkspacesilent "3,address:$ADDRESS"
fi

# --- Workspace 11: Notion (launched last so polling is uninterrupted) ---
hyprctl dispatch workspace 11
sleep $SLEEP
~/.local/bin/toggle-notion.sh &

echo "Waiting for Notion window..."
for i in $(seq 1 20); do
    NOTION_ADDR=$(hyprctl clients -j | jq -r '.[] | select(.class | startswith("chrome-") and contains("notion.so")) | .address' | head -1)
    if [ -n "$NOTION_ADDR" ]; then
        hyprctl dispatch movetoworkspacesilent "11,address:$NOTION_ADDR"
        echo "Notion moved to workspace 11"
        break
    fi
    sleep 0.5
done

if [ -z "$NOTION_ADDR" ]; then
    notify-send "Work Workflow" "⚠ Notion window not found" -t 4000
fi

# Return to workspace 1 when done
hyprctl dispatch workspace 1
notify-send "Work Workflow" "Applications launched" -t 3000
