#!/bin/bash
trap 'qs ipc -c "QuickShell Bar" call screenshot end' EXIT
qs ipc -c "QuickShell Bar" call screenshot begin
GEOM=$(slurp)
[ -z "$GEOM" ] && exit 1
# slurp prints "X,Y WxH"; match on the region's centre against windows that are actually
# on screen (mapped, on a monitor's active workspace), floating first, then most recently focused
read -r CX CY < <(echo "$GEOM" | awk '{split($1,p,","); split($2,s,"x"); print int(p[1]+s[1]/2), int(p[2]+s[2]/2)}')
TITLE=$(hyprctl clients -j | jq -r --argjson cx "$CX" --argjson cy "$CY" \
  --argjson ws "$(hyprctl monitors -j | jq '[.[].activeWorkspace.id]')" '
  [.[] | select(
    .mapped and (.hidden | not) and (.workspace.id as $w | $ws | index($w)) and
    .at[0] <= $cx and .at[1] <= $cy and
    (.at[0] + .size[0]) >= $cx and
    (.at[1] + .size[1]) >= $cy
  )] | sort_by([(if .floating then 0 else 1 end), .focusHistoryID]) | first | .title // "region"
' | tr -s " " "_" | tr -cd "[:alnum:]_-")
TITLE=${TITLE:-region}
FILE=~/Pictures/Screenshots/region-${TITLE}-$(date +%s).png
grim -g "$GEOM" - | tee "$FILE" | wl-copy
trap - EXIT
qs ipc -c "QuickShell Bar" call screenshot end
ACTION=$(notify-send -a "Screenshot" -A "default=Open in satty" "Region" "$FILE" --wait)
[ "$ACTION" = "default" ] && satty -f "$FILE"
