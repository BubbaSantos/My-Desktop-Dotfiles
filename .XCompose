
# Run omarchy-restart-xcompose in the terminal to get the changes picked up.
#
# Shared entries live in ~/xcompose-sync/xcompose/synced.xcompose (synced via git).
# Machine-local secrets live in ~/.XCompose.local (never synced).
# Don't edit synced.xcompose directly — use `syncadd` instead.
# Edit those files directly — this file just wires them together.
#
# --- Syncing across machines ---------------------------------------------------
# Don't edit this file directly — use "syncadd" instead.
# ------------------------------------------------------------------------------

include "/home/bubba/xcompose-sync/xcompose/synced.xcompose"
include "/home/bubba/.XCompose.local"
